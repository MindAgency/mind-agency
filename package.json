{
  "name": "mind-agency",
  "version": "1.0.0",
  "description": "Mind Agency — From Agent to Agency. 一个 AI 做不了的事，一群 AI 可以。",
  "scripts": {
    "build:mcp": "node scripts/build-mcp.mjs",
    "dev": "npm run build:mcp && npx tsx server.ts",
    "start": "npx tsx server.ts",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "release:check": "npx tsc --noEmit && npm test && npm run smoke:runtime",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "agent",
    "agency",
    "collaboration",
    "multi-agent",
    "workflow",
    "ai",
    "mcp"
  ],
  "author": "Toufumind",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Toufumind/mind-agency.git"
  },
  "homepage": "https://github.com/Toufumind/mind-agency#readme",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@lancedb/lancedb": "^0.30.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
